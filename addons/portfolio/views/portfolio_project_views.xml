<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_portfolio_project_list" model="ir.ui.view">
        <field name="name">portfolio.project.list</field>
        <field name="model">portfolio.project</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="url_key"/>
                <field name="website_published"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_portfolio_project_form" model="ir.ui.view">
        <field name="name">portfolio.project.form</field>
        <field name="model">portfolio.project</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_button_box" name="button_box"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Project Name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="url_key" placeholder="my-project"/>
                            <field name="sequence"/>
                        </group>
                        <group>
                            <field name="website_published"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <group>
                        <field name="description" placeholder="Short description or excerpt…"/>
                    </group>
                    <separator string="Content"/>
                    <field name="body" widget="html" options="{'collaborative': false}"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_portfolio_project" model="ir.actions.act_window">
        <field name="name">Portfolio Projects</field>
        <field name="res_model">portfolio.project</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem
        id="menu_portfolio_root"
        name="Portfolio"
        parent="website.menu_website_configuration"
        sequence="90"
    />
    <menuitem
        id="menu_portfolio_projects"
        name="Projects"
        parent="menu_portfolio_root"
        action="action_portfolio_project"
        sequence="10"
    />

</odoo>
